{{!-- Skills & Spells List --}}
<div class="skills-container">
  {{!-- Category Filters --}}
  <div class="skills-filters flexrow">
    <button class="skill-filter active" data-category="all">All</button>
    <button class="skill-filter" data-category="general">General</button>
    <button class="skill-filter" data-category="combat">Combat</button>
    <button class="skill-filter" data-category="magic">Magic</button>
    <button class="skill-filter" data-category="utility">Utility</button>
  </div>

  <div class="skills-header items-header flexrow">
    <div class="skill-name-header">Name</div>
    <div class="skill-info-header flexrow">
      <div class="skill-level-header">Level</div>
      <div class="skill-stat-header">Stat</div>
      <div class="skill-category-header">Category</div>
    </div>
    <div class="skill-controls-header">Actions</div>
  </div>

  <ol class="skills-list">
    {{!-- Skills --}}
    {{#each skills as |skill skillUuid|}}
    <li class="skill item flexrow" data-skill-uuid="{{skill.uuid}}" data-skill-category="{{skill.category}}">
      <div class="skill-name">
        <h4>{{skill.name}}</h4>
        {{#if skill.sources}}
          <div class="skill-sources">
            {{#each skill.sources}}
              <span class="source-tag" title="{{name}} (Level {{level}})">{{type}} +{{level}}</span>
            {{/each}}
          </div>
        {{/if}}
        {{#if skill.missing}}
          <span class="skill-missing">Skill item not owned</span>
        {{/if}}
      </div>

      <div class="skill-info flexrow">
        <div class="skill-level">
          <span class="level-value">{{skill.level}}</span>
          <span class="dice-pool">({{skill.level}}d6{{#if skill.relatedStat}}+{{lookup (lookup @root.system.abilities skill.relatedStat) 'mod'}}{{/if}})</span>
          {{#if skill.effort}}
            <span class="effort-cost">{{skill.effort}} stamina</span>
          {{/if}}
        </div>

        {{#if skill.relatedStat}}
        <div class="skill-stat">
          <span>{{lookup @root.config.abilityAbbreviations skill.relatedStat}}</span>
        </div>
        {{else}}
        <div class="skill-stat">
          <span class="no-stat">—</span>
        </div>
        {{/if}}

        <div class="skill-category">
          <span class="category-tag">{{skill.category}}</span>
        </div>
      </div>

      <div class="skill-controls flexrow">
        <a class="skill-roll" title="Roll Skill"><i class="fas fa-dice-d6"></i></a>
        {{#if skill.id}}
          <a class="item-edit" data-item-id="{{skill.id}}" title="Edit Skill"><i class="fas fa-edit"></i></a>
          <a class="item-delete" data-item-id="{{skill.id}}" title="Delete Skill"><i class="fas fa-trash"></i></a>
        {{else}}
          <a class="skill-missing-action" title="Skill item not on character" disabled><i class="fas fa-exclamation-triangle"></i></a>
        {{/if}}
      </div>
    </li>
    {{/each}}

    {{!-- Spells --}}
    {{#each spells as |spells spellLevel|}}
      {{#each spells as |item id|}}
      <li class="skill item flexrow spell-item" data-item-id="{{item._id}}" data-skill-category="magic">
        <div class="skill-name">
          <h4>{{item.name}}</h4>
          <span class="skill-parent">Spell</span>
        </div>

        <div class="skill-info flexrow">
          <div class="skill-level">
            <span class="level-value">{{spellLevel}}</span>
            <span class="dice-pool">({{item.system.diceCount}}d6{{#if item.system.castStat}}+{{lookup (lookup @root.system.abilities item.system.castStat) 'mod'}}{{/if}})</span>
            {{#if item.system.prowess}}
              <span class="prowess-cost">{{item.system.prowess}} mana</span>
            {{/if}}
          </div>

          {{#if item.system.castStat}}
          <div class="skill-stat">
            <span>{{lookup @root.config.abilityAbbreviations item.system.castStat}}</span>
          </div>
          {{else}}
          <div class="skill-stat">
            <span class="no-stat">—</span>
          </div>
          {{/if}}

          <div class="skill-category">
            <span class="category-tag">Magic</span>
          </div>
        </div>

        <div class="skill-controls flexrow">
          <a class="spell-roll" title="Cast Spell"><i class="fas fa-dice-d6"></i></a>
          <a class="item-edit" title="Edit Spell"><i class="fas fa-edit"></i></a>
          <a class="item-delete" title="Delete Spell"><i class="fas fa-trash"></i></a>
        </div>
      </li>
      {{/each}}
    {{/each}}
  </ol>
</div>

<div class="skills-footer">
  <a class="item-create skill-create" data-type="skill"><i class="fas fa-plus"></i> Add Skill</a>
</div>
