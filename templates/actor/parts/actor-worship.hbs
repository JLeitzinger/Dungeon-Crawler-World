<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-controls'></div>
  </li>
  {{#each gods as |god id|}}
    <li class='item flexrow' data-item-id='{{god._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='item'>
            <img
              src='{{god.img}}'
              title='{{god.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <div class='item-details'>
          <h4>{{god.name}}</h4>
          {{#if god.system.description}}
            <div class='item-description'>{{god.system.description}}</div>
          {{/if}}
        </div>
      </div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='God'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='God'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
{{#unless gods.length}}
<p class="worship-empty">No gods worshipped. Drag one in from a compendium to get started.</p>
{{/unless}}
