<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-rarity'>Rarity</div>
    <div class='item-effort'>Effort</div>
    <div class='item-formula'>Damage</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type='Weapon'}}'
        data-type='weapon'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='weapon'}}
      </a>
    </div>
  </li>
  {{#each weapons as |weapon id|}}
    <li class='item flexrow {{#if weapon.system.equipped}}equipped{{/if}}' data-item-id='{{weapon._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='weapon-roll rollable' title='Roll weapon attack'>
            <img
              src='{{weapon.img}}'
              title='{{weapon.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <h4>{{weapon.name}}</h4>
      </div>
      <div class='item-rarity item-prop'>
        <span class='rarity-{{weapon.system.rarity}}'>{{weapon.system.rarity}}</span>
      </div>
      <div class='item-effort item-prop'>{{weapon.system.effort}}</div>
      <div class='item-formula item-prop'>{{weapon.system.formula}}</div>
      <div class='item-controls'>
        <a
          class='item-control weapon-equip-toggle {{#if weapon.system.equipped}}equipped{{/if}}'
          title='{{#if weapon.system.equipped}}Unequip weapon{{else}}Equip weapon{{/if}}'
        >
          <i class='fas {{#if weapon.system.equipped}}fa-check-circle{{else}}fa-circle{{/if}}'></i>
        </a>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Weapon'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Weapon'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
