<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-rarity'>Rarity</div>
    <div class='item-effort'>Effort</div>
    <div class='item-dr'>DR</div>
    <div class='item-controls'></div>
  </li>
  {{#each armor as |piece id|}}
    <li class='item flexrow {{#if piece.system.equipped}}equipped{{/if}}' data-item-id='{{piece._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <img
            src='{{piece.img}}'
            title='{{piece.name}}'
            width='24'
            height='24'
          />
        </div>
        <h4>{{piece.name}}</h4>
      </div>
      <div class='item-rarity item-prop'>
        <span class='rarity-{{piece.system.rarity}}'>{{piece.system.rarity}}</span>
      </div>
      <div class='item-effort item-prop'>{{piece.system.effort}}</div>
      <div class='item-dr item-prop'>{{piece.system.damageReduction}}</div>
      <div class='item-controls'>
        <a
          class='item-control armor-equip-toggle {{#if piece.system.equipped}}equipped{{/if}}'
          title='{{#if piece.system.equipped}}Unequip armor{{else}}Equip armor{{/if}}'
        >
          <i class='fas {{#if piece.system.equipped}}fa-check-circle{{else}}fa-circle{{/if}}'></i>
        </a>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type='Armor'}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type='Armor'}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
