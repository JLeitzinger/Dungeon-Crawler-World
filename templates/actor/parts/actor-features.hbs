<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-source'>Source</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='Create item'
        data-type='feature'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='feature'}}
      </a>
    </div>
  </li>
  {{#each features as |item id|}}
    <li class='item flexrow{{#if item.source}} {{item.source}}{{/if}}' data-item-id='{{item._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <a class='rollable' data-roll-type='item'>
            <img
              src='{{item.img}}'
              title='{{item.name}}'
              width='24'
              height='24'
            />
          </a>
        </div>
        <div class='item-details'>
          <h4>{{item.name}}</h4>
          {{#if item.system.description}}
            <div class='item-description'>{{item.system.description}}</div>
          {{/if}}
        </div>
      </div>
      <div class='item-source'>
        {{#if item.source}}
          <span class='source-tag race-source'>{{item.source}}</span>
        {{/if}}
      </div>
      <div class='item-controls'>
        {{#unless item.source}}
          <a
            class='item-control item-edit'
            title='{{localize "DOCUMENT.Edit" type='feature'}}'
          >
            <i class='fas fa-edit'></i>
          </a>
          <a
            class='item-control item-delete'
            title='{{localize "DOCUMENT.Delete" type='feature'}}'
          >
            <i class='fas fa-trash'></i>
          </a>
        {{else}}
          <span class='locked-feature' title='Granted by {{item.source}}'><i class='fas fa-lock'></i></span>
        {{/unless}}
      </div>
    </li>
  {{/each}}
</ol>