<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-2col'>
        <div class='resource'>
          <label class='resource-label'>Tier</label>
          <select name='system.tier' data-dtype='String'>
            <option value='bronze' {{#if (eq system.tier 'bronze')}}selected{{/if}}>Bronze</option>
            <option value='silver' {{#if (eq system.tier 'silver')}}selected{{/if}}>Silver</option>
            <option value='gold' {{#if (eq system.tier 'gold')}}selected{{/if}}>Gold</option>
            <option value='platinum' {{#if (eq system.tier 'platinum')}}selected{{/if}}>Platinum</option>
            <option value='legendary' {{#if (eq system.tier 'legendary')}}selected{{/if}}>Legendary</option>
            <option value='celestial' {{#if (eq system.tier 'celestial')}}selected{{/if}}>Celestial</option>
          </select>
        </div>
        <div class='resource'>
          <label class='resource-label'>Quantity</label>
          <input
            type='text'
            name='system.quantity'
            value='{{system.quantity}}'
            data-dtype='Number'
          />
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>
    <div class='tab' data-group='primary' data-tab='description'>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>
  </section>
</form>
