<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
      <div class='grid grid-4col'>
        <div class='resource'>
          <label class='resource-label'>Reward Type</label>
          <select name='system.rewardType' data-dtype='String'>
            <option value='none' {{#if (eq system.rewardType 'none')}}selected{{/if}}>No Reward</option>
            <option value='lootbox' {{#if (eq system.rewardType 'lootbox')}}selected{{/if}}>Lootbox</option>
            <option value='item' {{#if (eq system.rewardType 'item')}}selected{{/if}}>Specific Item (UUID)</option>
          </select>
        </div>
        <div class='resource'>
          <label class='resource-label'>Lootbox Tier</label>
          <select name='system.rewardTier' data-dtype='String'>
            <option value='bronze' {{#if (eq system.rewardTier 'bronze')}}selected{{/if}}>Bronze</option>
            <option value='silver' {{#if (eq system.rewardTier 'silver')}}selected{{/if}}>Silver</option>
            <option value='gold' {{#if (eq system.rewardTier 'gold')}}selected{{/if}}>Gold</option>
            <option value='platinum' {{#if (eq system.rewardTier 'platinum')}}selected{{/if}}>Platinum</option>
            <option value='legendary' {{#if (eq system.rewardTier 'legendary')}}selected{{/if}}>Legendary</option>
            <option value='celestial' {{#if (eq system.rewardTier 'celestial')}}selected{{/if}}>Celestial</option>
          </select>
        </div>
        <div class='resource'>
          <label class='resource-label'>Reward Item UUID</label>
          <input
            type='text'
            name='system.rewardUuid'
            value='{{system.rewardUuid}}'
            placeholder='Only used when Reward Type = Item'
            data-dtype='String'
          />
        </div>
        <div class='resource'>
          <label class='resource-label'>Reward Quantity</label>
          <input
            type='text'
            name='system.rewardQuantity'
            value='{{system.rewardQuantity}}'
            data-dtype='Number'
          />
        </div>
      </div>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>
    <div class='tab' data-group='primary' data-tab='description'>
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>
  </section>
</form>
