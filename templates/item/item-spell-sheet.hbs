<form class='{{cssClass}}' autocomplete='off'>
  <header class='sheet-header'>
    <img
      class='profile-img'
      src='{{item.img}}'
      data-edit='img'
      title='{{item.name}}'
    />
    <div class='header-fields'>
      <h1 class='charname'><input
          name='name'
          type='text'
          value='{{item.name}}'
          placeholder='Name'
        /></h1>
    </div>
  </header>

  {{! Sheet Tab Navigation }}
  <nav class='sheet-tabs tabs' data-group='primary'>
    <a class='item' data-tab='description'>Description</a>
    <a class='item' data-tab='attributes'>Attributes</a>
    <a class='item' data-tab='skills'>Skills</a>
  </nav>

  {{! Sheet Body }}
  <section class='sheet-body'>

    {{! Description Tab }}
    <div class='tab' data-group='primary' data-tab='description'>
      {{! Editors must receive enriched text data from getData to properly handle rolls }}
      {{editor
        enrichedDescription
        target='system.description'
        engine='prosemirror'
        button=true
        editable=editable
      }}
    </div>

    {{! Attributes Tab }}
    <div class='tab attributes' data-group='primary' data-tab='attributes'>
      {{! As you add new fields, add them in here! }}
      <div class='resource'>
        <label class='resource-label'>Spell Level</label>
        <input
          type='text'
          name='system.spellLevel'
          value='{{system.spellLevel}}'
          data-dtype='Number'
        />
      </div>
      <div class='resource'>
        <label class='resource-label'>Dice Count</label>
        <input
          type='text'
          name='system.diceCount'
          value='{{system.diceCount}}'
          data-dtype='Number'
        />
      </div>
      <div class='resource'>
        <label class='resource-label'>Cast Stat</label>
        <select name='system.castStat' data-dtype='String'>
          <option value="">None</option>
          <option value="str" {{#if (eq system.castStat "str")}}selected{{/if}}>STR</option>
          <option value="dex" {{#if (eq system.castStat "dex")}}selected{{/if}}>DEX</option>
          <option value="con" {{#if (eq system.castStat "con")}}selected{{/if}}>CON</option>
          <option value="int" {{#if (eq system.castStat "int")}}selected{{/if}}>INT</option>
          <option value="wis" {{#if (eq system.castStat "wis")}}selected{{/if}}>WIS</option>
          <option value="cha" {{#if (eq system.castStat "cha")}}selected{{/if}}>CHA</option>
        </select>
      </div>
      <div class='resource'>
        <label class='resource-label'>Prowess (Mana Cost)</label>
        <input
          type='text'
          name='system.prowess'
          value='{{system.prowess}}'
          data-dtype='Number'
        />
        <p class='notes'>Amount of mana spent when casting this spell.</p>
      </div>
    </div>

    {{! Skills Tab }}
    <div class='tab skills' data-group='primary' data-tab='skills'>
      <div class='granted-skills'>
        <h3>Granted Skills</h3>
        <p class='notes'>This spell grants the following skills to characters who have it.</p>
        <ol class='granted-skills-list'>
          {{#each system.grantedSkills}}
          <li class='granted-skill flexrow' data-index='{{@index}}'>
            <div class='skill-info'>
              <input
                type='text'
                name='system.grantedSkills.{{@index}}.skillUuid'
                value='{{skillUuid}}'
                placeholder='Skill UUID'
                data-dtype='String'
              />
              <input
                type='number'
                name='system.grantedSkills.{{@index}}.level'
                value='{{level}}'
                data-dtype='Number'
                min='0'
                title='Level granted'
              />
            </div>
            <a class='granted-skill-delete' title='Remove Skill'><i class='fas fa-trash'></i></a>
          </li>
          {{/each}}
        </ol>
        <a class='granted-skill-add'><i class='fas fa-plus'></i> Add Skill</a>
      </div>
    </div>
  </section>
</form>