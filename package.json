{
  "name": "dungeon-crawler-world",
  "version": "2.0.0",
  "description": "CSS compiler for the dccworld system",
  "scripts": {
    "build": "sass src/scss/dungeon-crawler-world.scss css/dungeon-crawler-world.css --style=expanded --no-source-map",
    "watch": "sass src/scss/dungeon-crawler-world.scss css/dungeon-crawler-world.css --style=expanded --source-map --watch",
    "generate:weapons": "node scripts/generators/generate-weapons.mjs",
    "generate:skills": "node scripts/generate-skills.mjs",
    "pack": "npm run pack:items && npm run pack:skills",
    "pack:items": "node scripts/pack-items.mjs",
    "pack:skills": "node scripts/pack-skills.mjs",
    "unpack": "npm run unpack:items",
    "unpack:items": "fvtt package unpack -n items --in packs --out src/packs/items --clean",
    "skill-lookup": "node scripts/skill-lookup.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^1.0.0",
    "classic-level": "^3.0.0",
    "sass": "^1.53.0"
  }
}
